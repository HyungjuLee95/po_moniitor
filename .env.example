# Frontend (browser-visible values only; frontend/vite.config.ts loads this root file)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Internal LLM JSON endpoint. Keep empty to use the not-configured response.
LLM_API_URL=
LLM_API_TIMEOUT_SECONDS=30

# Application
APP_NAME=PO Monitor Main
APP_VERSION=0.1.0
DEMO_MODE=true
SAP_PO_LIVE_MODE=false
SECRET_KEY=replace-with-a-long-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=480
CORS_ORIGINS_RAW=http://localhost:3000

# PostgreSQL
DATABASE_URL=postgresql+psycopg://po_monitor:replace-me@localhost:5432/po_monitor
DATABASE_CONNECT_ON_STARTUP=false

# Existing Oracle RTIMS is a separate read/write monitoring source.
RTIMS_ENABLED=false
RTIMS_ORACLE_HOST=
RTIMS_ORACLE_PORT=1521
RTIMS_ORACLE_SERVICE=
RTIMS_ORACLE_USER=
RTIMS_ORACLE_PASSWORD=
RTIMS_POOL_MIN=1
RTIMS_POOL_MAX=5

# SAP PO credentials are shared by configured servers.
SAP_PO_USER=
SAP_PO_PASSWORD=
SAP_VERIFY_TLS=true
SAP_CONNECT_TIMEOUT_SECONDS=10
SAP_READ_TIMEOUT_SECONDS=60
SAP_RETRY_COUNT=2
SAP_CONTROL_ALLOWED_SIDS_RAW=POQ

# WSDL and Directory paths. Change only when the SAP PO installation differs.
SAP_CHANNEL_WSDL_PATH=/CommunicationChannelInService/CommunicationChannelInImplBean?wsdl
SAP_CHANNEL_ADMIN_WSDL_PATH=/ChannelAdminService/ChannelAdmin?wsdl
SAP_ADAPTER_MONITOR_WSDL_PATH=/AdapterMessageMonitoring/basic?wsdl
SAP_AAE_MONITOR_WSDL_PATH=/AaeMessageMonitorService/AaeMessageMonitor?wsdl
SAP_SYSTATUS_WSDL_PATH=/SystatusService/Systatus?wsdl
SAP_BUSINESS_SYSTEM_WSDL_PATH=/BusinessSystemInService/BusinessSystemInImplBean?wsdl
SAP_INTERFACE_MONITOR_WSDL_PATH=/InterfaceMonitorService/InterfaceMonitor?wsdl
SAP_DIRECTORY_PATH=/dir/read/ext
SAP_HRD_CHANNEL_PATTERN=JDBC4_Receiver_DIST_HRD*
SAP_HRD_TEST_PATH=/HttpAdapter/HttpMessageServlet
SAP_HRD_TEST_INTERFACE=
SAP_HRD_SENDER_SERVICES_JSON={}

# Optional SAP PO HANA schedule lookup for HRD batch descriptions.
SAP_HANA_HOST=
SAP_HANA_PORT=30015
SAP_HANA_USER=
SAP_HANA_PASSWORD=

# AAE message collector parameters from the existing RTIMS collector contract.
SAP_AAE_DELIVERY_SEMANTICS=BE
SAP_AAE_HOST_ID_TABLE=
SAP_AAE_HOST_ID_FIELD=
SAP_MESSAGE_LOOKBACK_MINUTES=60

# Existing Oracle IFS source, separate from RTIMS Oracle.
IFS_ORACLE_ENABLED=false
IFS_ORACLE_HOST=
IFS_ORACLE_PORT=1521
IFS_ORACLE_SERVICE=
IFS_ORACLE_USER=
IFS_ORACLE_PASSWORD=
IFS_SYNC_SCHEDULER_ENABLED=false
IFS_SYNC_INTERVAL_SECONDS=3600

# Add or remove servers in this JSON array. Restart the backend after editing.
PO_SERVERS_JSON=[{"sid":"POP","display_name":"PO Production","environment":"production","base_url":"https://po-prod.internal.example","port":50000,"enabled":true,"capabilities":["monitor","audit","collector"]},{"sid":"POQ","display_name":"PO Quality","environment":"quality","base_url":"https://po-qa.internal.example","port":50000,"enabled":true,"capabilities":["monitor","channel-control","audit","collector","hrd"]}]

# Local demo login (DEMO_MODE=true only)
DEMO_ADMIN_USERNAME=admin
DEMO_ADMIN_PASSWORD=demo1234
