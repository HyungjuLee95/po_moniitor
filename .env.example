# Frontend (browser-visible values only; frontend/next.config.ts loads this root file)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Internal LLM JSON endpoint. Keep empty to use the not-configured response.
LLM_API_URL=
LLM_API_TIMEOUT_SECONDS=30

# Application
APP_NAME=PO Monitor Main
APP_VERSION=0.1.0
DEMO_MODE=true
SAP_PO_LIVE_MODE=false
SECRET_KEY=replace-with-a-long-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=480
CORS_ORIGINS_RAW=http://localhost:3000

# PostgreSQL
DATABASE_URL=postgresql+psycopg://po_monitor:replace-me@localhost:5432/po_monitor
DATABASE_CONNECT_ON_STARTUP=false

# Existing Oracle RTIMS is a separate read/write monitoring source.
RTIMS_ENABLED=false
# Optional PostgreSQL RTIMS target. Empty means use DATABASE_URL for setup.
RTIMS_POSTGRES_DATABASE_URL=
RTIMS_ORACLE_HOST=
RTIMS_ORACLE_PORT=1521
RTIMS_ORACLE_SERVICE=
# Owner schema for runtime unqualified SQL. Empty means runtime user's schema.
RTIMS_ORACLE_SCHEMA=
RTIMS_ORACLE_USER=
RTIMS_ORACLE_PASSWORD=
# Schema-owner credentials are used only by the explicit one-click DDL script.
# Do not grant DDL privileges to the runtime account unless policy requires it.
RTIMS_ORACLE_DDL_USER=
RTIMS_ORACLE_DDL_PASSWORD=
RTIMS_POOL_MIN=1
RTIMS_POOL_MAX=5

# Automatic Collector lifecycle. OFF by default. Servers with a collectors
# profile read bounded AAE pages from HANA, write MON_BUF_AAE_MSG, call
# process_msg_logs, and advance the Oracle checkpoint in one transaction.
RTIMS_COLLECTOR_ENABLED=false
RTIMS_COLLECTOR_STARTUP_DELAY_SECONDS=30
# Compatibility defaults for collector-capability servers without profiles.
RTIMS_COLLECTOR_INTERVAL_SECONDS=300
RTIMS_COLLECTOR_LIMIT=500
# Optional dedicated DML/procedure account. Empty values fall back to the
# RTIMS_ORACLE_USER/PASSWORD runtime account.
RTIMS_COLLECTOR_ORACLE_USER=
RTIMS_COLLECTOR_ORACLE_PASSWORD=

# Common SAP PO credentials. A server-specific username/password in
# PO_SERVERS_JSON takes precedence; keep these as the fallback only.
SAP_PO_USER=
SAP_PO_PASSWORD=
SAP_VERIFY_TLS=true
SAP_CONNECT_TIMEOUT_SECONDS=10
SAP_READ_TIMEOUT_SECONDS=60
SAP_RETRY_COUNT=2
SAP_CONTROL_ALLOWED_SIDS_RAW=POQ

# Common WSDL and HTTP paths. A server-specific endpoint_paths entry in
# PO_SERVERS_JSON takes precedence when one installation differs.
SAP_CHANNEL_WSDL_PATH=/CommunicationChannelInService/CommunicationChannelInImplBean?wsdl
SAP_CHANNEL_ADMIN_WSDL_PATH=/ChannelAdminService/ChannelAdmin?wsdl
SAP_ADAPTER_MONITOR_WSDL_PATH=/AdapterMessageMonitoring/basic?wsdl
SAP_AAE_MONITOR_WSDL_PATH=/AaeMessageMonitorService/AaeMessageMonitor?wsdl
SAP_SYSTATUS_WSDL_PATH=/SystatusService/Systatus?wsdl
SAP_BUSINESS_SYSTEM_WSDL_PATH=/BusinessSystemInService/BusinessSystemInImplBean?wsdl
SAP_INTERFACE_MONITOR_WSDL_PATH=/InterfaceMonitorService/InterfaceMonitor?wsdl
SAP_DIRECTORY_PATH=/dir/read/ext
SAP_HRD_CHANNEL_PATTERN=JDBC4_Receiver_DIST_HRD*
SAP_HRD_TEST_PATH=/HttpAdapter/HttpMessageServlet
SAP_HRD_TEST_INTERFACE=
SAP_HRD_SENDER_SERVICES_JSON={}
SAP_KEYSTORE_HELP_PATH=/KeystoreHelp/basic?style=document
SAP_KEYSTORE_CERTIFICATES_PATH=/KeystoreService/KeystoreServiceApi
SAP_KEYSTORE_MAX_RESPONSE_BYTES=10000000

# Common HANA fallback for HRD and Collector profiles. Profile-specific HANA
# values in PO_SERVERS_JSON take precedence.
SAP_HANA_HOST=
SAP_HANA_PORT=30015
SAP_HANA_USER=
SAP_HANA_PASSWORD=

# Legacy compatibility collector parameters. Oracle Collector profiles use the
# delivery_semantics and host mapping declared inside PO_SERVERS_JSON.
SAP_AAE_DELIVERY_SEMANTICS=BE
SAP_AAE_HOST_ID_TABLE=
SAP_AAE_HOST_ID_FIELD=
SAP_MESSAGE_LOOKBACK_MINUTES=60

# Existing Oracle IFS source, separate from RTIMS Oracle.
IFS_ORACLE_ENABLED=false
IFS_ORACLE_HOST=
IFS_ORACLE_PORT=1521
IFS_ORACLE_SERVICE=
IFS_ORACLE_USER=
IFS_ORACLE_PASSWORD=
IFS_SYNC_SCHEDULER_ENABLED=false
IFS_SYNC_INTERVAL_SECONDS=3600

# Add or remove servers in this JSON array. base_url, port, username, password,
# endpoint_paths, WSDL host_aliases, and collectors are independently
# configurable for every SID. Every oracle_instance_id must be globally unique.
# Restart the backend after editing. Never commit the populated .env file.
PO_SERVERS_JSON=[{"sid":"POP","display_name":"PO Production","environment":"production","base_url":"https://po-prod.internal.example","port":50000,"username":"replace-pop-user","password":"replace-pop-password","enabled":true,"capabilities":["monitor","audit","collector"],"collectors":[{"collector_id":"aae-be","oracle_instance_id":101,"delivery_semantics":"BE","interval_seconds":300,"limit":500,"initial_lookback_seconds":3600,"pending_search_minutes":30,"hana_host":"replace-pop-hana-host","hana_port":30015,"hana_user":"replace-pop-hana-user","hana_password":"replace-pop-hana-password","po_db_schema":"REPLACE_POP_SCHEMA"}]},{"sid":"POQ","display_name":"PO Quality","environment":"quality","base_url":"https://po-qa.internal.example","port":50000,"username":"replace-poq-user","password":"replace-poq-password","endpoint_paths":{"channels":"/CommunicationChannelInService/CommunicationChannelInImplBean?wsdl","directory":"/dir/read/ext","hrd_test":"/HttpAdapter/HttpMessageServlet","keystore_help":"/KeystoreHelp/basic?style=document","keystore_certificates":"/KeystoreService/KeystoreServiceApi"},"host_aliases":["po-qa-short"],"enabled":true,"capabilities":["monitor","channel-control","audit","collector","hrd"],"collectors":[{"collector_id":"aae-be","oracle_instance_id":201,"delivery_semantics":"BE","interval_seconds":300,"limit":500,"pending_search_minutes":30,"hana_host":"replace-poq-hana-host","hana_port":30015,"hana_user":"replace-poq-hana-user","hana_password":"replace-poq-hana-password","po_db_schema":"REPLACE_POQ_SCHEMA"},{"collector_id":"aae-eo","oracle_instance_id":202,"delivery_semantics":"EO","interval_seconds":600,"limit":500,"pending_search_minutes":30,"hana_host":"replace-poq-hana-host","hana_port":30015,"hana_user":"replace-poq-hana-user","hana_password":"replace-poq-hana-password","po_db_schema":"REPLACE_POQ_SCHEMA"}]}]

# Local demo login (DEMO_MODE=true only)
DEMO_ADMIN_USERNAME=admin
DEMO_ADMIN_PASSWORD=1234
