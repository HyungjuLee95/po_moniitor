# Frontend (browser-visible values only)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Application
APP_NAME=PO Monitor Main
APP_VERSION=0.1.0
DEMO_MODE=true
SECRET_KEY=replace-with-a-long-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=480
CORS_ORIGINS_RAW=http://localhost:3000

# PostgreSQL
DATABASE_URL=postgresql+psycopg://po_monitor:replace-me@localhost:5432/po_monitor
DATABASE_CONNECT_ON_STARTUP=false

# SAP PO credentials are shared by configured servers.
SAP_PO_USER=
SAP_PO_PASSWORD=
SAP_VERIFY_TLS=true

# Add or remove servers in this JSON array. Restart the backend after editing.
PO_SERVERS_JSON=[{"sid":"POP","display_name":"PO Production","environment":"production","base_url":"https://po-prod.internal.example","port":50000,"enabled":true,"capabilities":["monitor","channel-control","audit","collector"]},{"sid":"POQ","display_name":"PO Quality","environment":"quality","base_url":"https://po-qa.internal.example","port":50000,"enabled":true,"capabilities":["monitor","channel-control","collector"]},{"sid":"POD","display_name":"PO Development","environment":"development","base_url":"https://po-dev.internal.example","port":50000,"enabled":true,"capabilities":["monitor","channel-control","collector","hrd"]}]

# Local demo login (DEMO_MODE=true only)
DEMO_ADMIN_USERNAME=admin
DEMO_ADMIN_PASSWORD=demo1234
